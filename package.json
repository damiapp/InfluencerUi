{
  "name": "influencer-studio",
  "description": "Personal AI image/video studio for consistent AI influencer content, powered by the Gemini API. Based on Open Generative AI.",
  "private": true,
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/studio"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/",
    "db:migrate:local": "wrangler d1 migrations apply influencer-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply influencer-studio --remote",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "studio": "*"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "wrangler": "^4.151.3"
  }
}
